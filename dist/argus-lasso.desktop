[Desktop Entry]
Name=Argus-Lasso
Comment=Linux process manager with CPU affinity, nice priority, ProBalance, and HW monitoring
Exec=argus-lasso
Icon=argus-lasso
Terminal=false
Type=Application
Categories=System;Monitor;
StartupNotify=false
StartupWMClass=argus-lasso
Actions=toggle-overlay;

[Desktop Action toggle-overlay]
Name=Show or hide the in-game overlay
Exec=argus-lasso toggle-overlay
