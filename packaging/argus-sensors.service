[Unit]
Description=Argus restricted hardware sensor reader
Documentation=https://github.com/franzjeger/argus-lasso

[Service]
Type=simple
ExecStart=/usr/local/libexec/argus-sensors
User=root
# Package power is root-only in the kernel (CVE-2020-8694), so the snapshot
# is readable by root and the service's group only. install-sensors.sh sets
# that group to the installing user's in a drop-in (reader.conf).
Group=root
RuntimeDirectory=argus-sensors
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# It reads sysfs and writes one file: no sockets, network, /proc or
# privileged system calls. As uid 0 it could otherwise reach the system
# bus or systemd's private socket if it were ever compromised.
RestrictAddressFamilies=none
PrivateNetwork=yes
IPAddressDeny=any
ProtectProc=invisible
ProcSubset=pid
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/run/argus-sensors

[Install]
WantedBy=multi-user.target
