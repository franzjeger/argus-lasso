[Unit]
Description=Argus restricted hardware sensor reader
Documentation=https://github.com/franzjeger/argus-lasso

[Service]
Type=simple
ExecStart=/usr/local/libexec/argus-sensors
User=root
Group=root
RuntimeDirectory=argus-sensors
RuntimeDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/run/argus-sensors

[Install]
WantedBy=multi-user.target
